# Скопировать в .env и заполнить реальными значениями.
# .env исключён из репозитория через .gitignore.
#
#   cp .env.example .env
#   export $(cat .env | xargs)

# --- MQTT (Adafruit IO) ---
MQTT_HOST=io.adafruit.com
MQTT_PORT=1883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_SECRET_KEY

# --- Telegram ---
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Telegram user_id через запятую; пусто = доступ открыт всем
ALLOWED_USERS=

# --- ESP32-CAM ---
CAM_IP=192.168.1.100

# --- Каталог истории телеметрии ---
GREENHOUSE_DATA_DIR=./data
